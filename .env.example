# Rearview environment template. Copy to .env and fill in real values.
# .env is gitignored and must never be committed. This file holds placeholders only.

# Neon PostgreSQL — pooled connection (PgBouncer). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require&pgbouncer=true"

# Neon PostgreSQL — direct connection (no pooler). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# Better Auth — session signing secret. Generate one with: openssl rand -base64 32
# Required. Never commit the real value.
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical origin the app is served from. An https:// value enables Secure
# cookies and is added to the CSRF trusted origins. Defaults to localhost:3000.
BETTER_AUTH_URL="http://localhost:3000"

# Sign-up self-locks after the first account is created. Set to "true" only to
# deliberately re-open registration. Optional — treated as closed when unset.
AUTH_ALLOW_REGISTRATION="false"

# Name used in the Overview greeting. Optional — falls back to the account's
# name, then to "Matthes", when unset.
REARVIEW_USER_NAME="Your Name"

# Ollama — local inference only. Never called from the browser, never external.
# Journal content is only ever sent to this one local endpoint.
OLLAMA_BASE_URL="http://localhost:11434"

# Text-generation model for synthesis. Must understand German, English and
# Spanish. llama3.1 (8B) works and is Meta-supported for all three; qwen2.5 is a
# fine alternative. Configuration only — never hardcoded in the app.
OLLAMA_GENERATION_MODEL="llama3.1"

# Embedding model. bge-m3 is multilingual (100+ languages) and emits
# 1024-dimensional vectors — good cross-language retrieval (a German query
# finding an English or Spanish entry). EMBEDDING_DIMENSIONS must match the
# model's real output AND the schema's vector(N) column; changing it needs a
# migration and a full re-embed.
EMBEDDING_MODEL="bge-m3"
EMBEDDING_DIMENSIONS="1024"
