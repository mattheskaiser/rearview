// Rearview — persistence schema.
//
// Design notes (per CLAUDE.md):
// - `journalDate` is the user-facing date the entry is ABOUT and is stored
//   explicitly as a DATE. It is distinct from `createdAt` (row insertion time).
//   Journal chronology must never be derived from `createdAt`.
// - One journal entry per calendar date PER USER: `@@unique([userId, journalDate])`.
//   This matches the Overview activity map (binary "entry exists on this date?")
//   and the single-result `getEntryByDate` access pattern.
// - Rich text is stored as TipTap document JSON in `content`. `contentText` is
//   the deterministically extracted plain text used for search and embeddings,
//   so retrieval never has to parse presentation markup.
// - `contentHash` is a hash of `contentText`; Phase 3 uses it to detect when an
//   edit has invalidated existing chunks/embeddings. Each `EntryChunk` records
//   the `sourceHash` it was derived from so a changed entry deterministically
//   regenerates its chunk set instead of leaving stale embeddings behind.
// - Embeddings live only in `EntryChunk` and are never selected into any
//   client-facing payload.
//
// Ownership (auth phase): every private record belongs to a `User`. Journal
// chunks / memory-entries are owned indirectly through their parent. `userId`
// is nullable only as a transient state for the auth migration — the first
// account adopts every pre-auth row, then a follow-up migration sets NOT NULL.
// Auth tables (`User`/`Session`/`Account`/`Verification`) are managed by Better
// Auth; their shape matches better-auth 1.7.x (`Account.issuer` included).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model JournalEntry {
  id          String   @id @default(cuid())
  journalDate DateTime @db.Date
  content     Json
  contentText String
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Owning user. Nullable only during the auth migration (see header note).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chunks        EntryChunk[]
  memoryEntries MemoryEntry[]

  // One entry per calendar date PER USER (was globally unique pre-auth).
  @@unique([userId, journalDate])
  @@index([userId])
}

model EntryChunk {
  id         String                      @id @default(cuid())
  entryId    String
  chunkIndex Int
  text       String
  // Hash of the parent entry's `contentText` this chunk was derived from.
  // When it no longer matches `JournalEntry.contentHash`, the chunk is stale.
  sourceHash String
  // pgvector column. Dimension MUST match EMBEDDING_DIMENSIONS (1024 for
  // bge-m3). Nullable: a chunk row is written first and embedded
  // asynchronously, so a failed embedding never corrupts the journal entry.
  embedding  Unsupported("vector(1024)")?
  model      String?
  createdAt  DateTime                    @default(now())
  embeddedAt DateTime?

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, chunkIndex])
  @@index([entryId])
}

model Memory {
  id        String   @id @default(cuid())
  question  String
  // Plain-text answer — retained for backward compatibility, search, and as the
  // log-safe text form.
  answer    String
  // The same answer as an editor-native TipTap document (paragraphs, line
  // breaks, bulleted / numbered lists, bold, italic). Written at save time from
  // the AI's Markdown so formatting survives save -> reload -> re-render. NULL on
  // rows created before this column existed; those are converted from `answer`
  // on read.
  answerDoc Json?
  createdAt DateTime @default(now())

  // Owning user. Nullable only during the auth migration (see header note).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries MemoryEntry[]

  @@index([userId])
}

model MemoryEntry {
  id          String   @id @default(cuid())
  memoryId    String
  entryId     String?
  // Date snapshot of the referenced entry, retained even if the entry is later
  // deleted. Saved memories are snapshots, not live views.
  journalDate DateTime @db.Date

  memory Memory        @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  entry  JournalEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([memoryId, entryId])
  @@index([memoryId])
}

model CurrentGoals {
  // One row per user (was a global singleton at id "singleton" pre-auth; that
  // row is adopted by the first account during the auth migration).
  id        String   @id @default(cuid())
  // Rich text as TipTap document JSON — same editor as journal entries.
  // `{}` is the "not yet written" sentinel. `text` is the deterministically
  // extracted plain text, kept for parity with JournalEntry.
  content   Json     @default("{}")
  text      String   @default("")
  updatedAt DateTime @updatedAt

  // Owning user. Nullable only during the auth migration (see header note).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Better Auth tables. Shape matches better-auth 1.7.x — do not edit field names
// by hand. `Account.password` (credential hash) is never selected by app code;
// `Account.issuer` scopes account identity (1.7 change).
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  journalEntries JournalEntry[]
  memories       Memory[]
  currentGoals   CurrentGoals?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
